<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_glass_card"
    android:elevation="2dp"
    android:padding="13dp">

    <ImageView
        android:id="@+id/imagePost"
        android:layout_width="100dp"
        android:layout_height="116dp"
        android:background="@drawable/bg_image_fallback"
        android:clipToOutline="true"
        android:scaleType="centerCrop"
        android:contentDescription="@string/app_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:src="@drawable/ic_image_fallback"/>

    <TextView
        android:id="@+id/textPostId"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="8dp"
        android:textColor="@color/accent_dark"
        android:textSize="10sp"
        android:letterSpacing="0.1"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/imagePost"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/buttonBookmark"
        tools:text="POST 7"/>

    <ImageButton
        android:id="@+id/buttonBookmark"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/bg_pill"
        android:padding="9dp"
        android:src="@drawable/ic_bookmark_outline"
        android:contentDescription="@string/save_bookmark"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/textTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        app:layout_constraintStart_toStartOf="@id/textPostId"
        app:layout_constraintEnd_toStartOf="@id/buttonBookmark"
        app:layout_constraintTop_toBottomOf="@id/textPostId"
        tools:text="A story worth remembering"/>

    <TextView
        android:id="@+id/textBody"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="3"
        android:ellipsize="end"
        android:textSize="12sp"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/text_secondary"
        app:layout_constraintStart_toStartOf="@id/textPostId"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textTitle"
        tools:text="A thoughtful short excerpt to read and save later."/>
</androidx.constraintlayout.widget.ConstraintLayout>
